<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Stories - Uzum Market</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --primary: #7000ff;
            --bg: #000000;
            --card: #1c1d22;
            --text: #ffffff;
            --muted: #8b8e99;
        }

        [data-theme="light"] {
            --bg: #f4f5f7;
            --card: #ffffff;
            --text: #1f2026;
            --muted: #8b8e99;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Yuqori qism: Telegram yopish tugmasi ostida joylashgan orqaga qaytish tugmasi */
        .story-header {
            position: absolute;
            top: 55px; /* Telegramning yopish (×) tugmasidan pastroqda joylashishi uchun */
            left: 16px;
            right: 16px;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .progress-bars {
            display: flex;
            gap: 4px;
            width: 100%;
        }

        .progress-bar {
            flex: 1;
            height: 3px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-fill {
            width: 0%;
            height: 100%;
            background: #ffffff;
            transition: width linear;
        }

        .header-nav-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .back-btn {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            backdrop-filter: blur(4px);
        }

        [data-theme="light"] .back-btn {
            background: rgba(255, 255, 255, 0.6);
            color: #1f2026;
            border-color: rgba(0, 0, 0, 0.1);
        }

        .back-btn svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.5;
        }

        /* Storis media kontenti (Video yoki Rasm) */
        .story-media-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            z-index: 1;
        }

        .story-media {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Pastki qism: Mahsulotga o'tish tugmasi */
        .story-footer {
            position: absolute;
            bottom: 30px;
            left: 16px;
            right: 16px;
            z-index: 100;
        }

        .product-preview-card {
            background: rgba(28, 29, 34, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }

        [data-theme="light"] .product-preview-card {
            background: rgba(255, 255, 255, 0.9);
            border-color: rgba(0, 0, 0, 0.1);
        }

        .preview-img {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            object-fit: cover;
            background: #fff;
        }

        .preview-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .preview-title {
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        [data-theme="light"] .preview-title {
            color: #1f2026;
        }

        .preview-price {
            font-size: 15px;
            font-weight: 800;
            color: #ffffff;
        }

        [data-theme="light"] .preview-price {
            color: #1f2026;
        }

        .preview-btn {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
        }
    </style>
</head>
<body>

    <div class="story-header">
        <div class="progress-bars" id="progressBars"></div>
        <div class="header-nav-row">
            <button class="back-btn" onclick="goBack()">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
        </div>
    </div>

    <div class="story-media-container" id="mediaContainer"></div>

    <div class="story-footer" id="storyFooter" style="display: none;">
        <div class="product-preview-card" id="productCardPreview">
            <img class="preview-img" id="prevImg" src="" alt="">
            <div class="preview-info">
                <div class="preview-title" id="prevTitle"></div>
                <div class="preview-price" id="prevPrice"></div>
            </div>
            <button class="preview-btn" id="btnText">Ko'rish</button>
        </div>
    </div>

    <script>
        const translations = {
            uz: { view_btn: "Ko'rish" },
            ru: { view_btn: "Смотреть" }
        };

        let currentLang = localStorage.getItem('selected_lang') || 'uz';
        let siteTheme = localStorage.getItem('site_theme') || 'dark';
        if (siteTheme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
        } else {
            document.documentElement.removeAttribute('data-theme');
        }

        let storiesList = [];
        let currentStoryIndex = 0;
        let allProducts = [];
        let timer = null;
        const STORY_DURATION = 5000; // Har bir storis 5 sekund davom etadi

        async function loadStoriesData() {
            try {
                let res = await fetch('database.json');
                if (res.ok) {
                    let db = await res.json();
                    storiesList = db.stories || [];
                    allProducts = db.products || [];
                }
            } catch (e) {
                console.error("Ma'lumotlarni o'qib bo'lmadi", e);
            }

            const urlParams = new URLSearchParams(window.location.search);
            let targetId = parseInt(urlParams.get('id')) || (storiesList[0] ? storiesList[0].id : 1);

            let foundIdx = storiesList.findIndex(s => s.id === targetId);
            if (foundIdx !== -1) currentStoryIndex = foundIdx;

            initProgressBars();
            playStory(currentStoryIndex);
        }

        function initProgressBars() {
            const container = document.getElementById('progressBars');
            container.innerHTML = storiesList.map((_, i) => `
                <div class="progress-bar">
                    <div class="progress-fill" id="prog-${i}"></div>
                </div>
            `).join('');
        }

        function playStory(index) {
            if (index < 0 || index >= storiesList.length) {
                goBack();
                return;
            }
            currentStoryIndex = index;
            let story = storiesList[currentStoryIndex];

            // Progress barlarni yangilash
            for (let i = 0; i < storiesList.length; i++) {
                let fill = document.getElementById(`prog-${i}`);
                if (i < currentStoryIndex) fill.style.width = '100%';
                else if (i === currentStoryIndex) fill.style.width = '0%';
                else fill.style.width = '0%';
            }

            // Media chiqarish (Video yoki Rasm)
            const mediaContainer = document.getElementById('mediaContainer');
            if (story.type === 'video') {
                mediaContainer.innerHTML = `<video class="story-media" src="${story.media}" autoplay playsinline muted></video>`;
            } else {
                mediaContainer.innerHTML = `<img class="story-media" src="${story.media}" alt="Story">`;
            }

            // Bog'langan mahsulotni chiqarish
            const footer = document.getElementById('storyFooter');
            if (story.product_id) {
                let prod = allProducts.find(p => p.id === story.product_id);
                if (prod) {
                    document.getElementById('prevImg').src = prod.images && prod.images[0] ? prod.images[0] : '';
                    document.getElementById('prevTitle').textContent = typeof prod.name === 'object' ? (prod.name[currentLang] || prod.name['uz']) : prod.name;
                    document.getElementById('prevPrice').textContent = prod.price;
                    document.getElementById('btnText').textContent = translations[currentLang].view_btn;
                    document.getElementById('productCardPreview').onclick = () => {
                        window.location.href = `product.html?id=${prod.id}`;
                    };
                    footer.style.display = 'block';
                } else {
                    footer.style.display = 'none';
                }
            } else {
                footer.style.display = 'none';
            }

            // Animatsiya boshlash
            let activeFill = document.getElementById(`prog-${currentStoryIndex}`);
            setTimeout(() => {
                activeFill.style.transition = `width ${STORY_DURATION}ms linear`;
                activeFill.style.width = '100%';
            }, 50);

            clearTimeout(timer);
            timer = setTimeout(() => {
                playStory(currentStoryIndex + 1);
            }, STORY_DURATION);
        }

        function goBack() {
            window.location.href = 'index.html';
        }

        // Ekranni bosganda oldinga/orqaga o'tish
        document.addEventListener('click', (e) => {
            if (e.target.closest('.back-btn') || e.target.closest('.story-footer')) return;
            let screenWidth = window.innerWidth;
            if (e.clientX < screenWidth / 3) {
                // Chapga bossa oldingi storis
                if (currentStoryIndex > 0) playStory(currentStoryIndex - 1);
            } else {
                // O'ngga bossa keyingi storis
                playStory(currentStoryIndex + 1);
            }
        });

        window.addEventListener('DOMContentLoaded', loadStoriesData);
    </script>
</body>
</html>
